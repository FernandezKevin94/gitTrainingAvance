#!/bin/bash

read -r -p "Sauvegarde de la base dans ce commit (y/[n]) ?" yn < /dev/tty

case $yn in
    [Yy]* )
        mkdir -p suivi

        echo "commit vérifié le $(date '+%d/%m/%Y à %H:%M:%S')" > suivi/commitInfo.txt

        git add suivi/commitInfo.txt
        exit 0
        ;;
    [Nn]* )
        exit 0
        ;;
    * )
        exit 0
        ;;
esac
