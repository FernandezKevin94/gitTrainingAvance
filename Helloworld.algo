Algo HelloWorld {
    fonction principale {
        // Création de la fenêtre
        Créer une fenêtre de titre HELLO_WORLD
        Mettre la dimension à 500, 350
        Configurer la fenêtre sur 'exitOnClose'

        // Création du label de texte
        Créer un label avec du texte centré et contenant le texte HELLO_WORLD
        Créer la couleur jaune
        Mettre la couleur jaune sur le label
        Créer la couleur cyan
        Mettre la couleur cyan en fond de la fenêtre

        // Modification réalisée directement depuis GitHub (C20)

        // Finalisation
        Ajouter le label sur la fenêtre
        Afficher la fenêtre
    }
}
